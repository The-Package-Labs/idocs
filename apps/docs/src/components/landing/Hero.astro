---
import Diagram from '@the-package-labs/idocs-astro/Diagram.astro'
import { diagrams } from 'virtual:idocs/diagrams'
import { withBase } from '../../lib/base'
import Icon from './Icon.astro'

// One diagram that uses most of the format, so the hero shows the product and not a sample of it.
const demo = diagrams.showcase!
const nodes = Object.keys(demo.nodes).length
const scenarios = demo.scenarios.length
const views = demo.views.length
const install = 'npm create idocs@latest my-docs'

// What the i in idocs stands for.
const iwords = [
  { word: 'nteractive', text: 'Click a box, expand a card, press play on a request.' },
  { word: 'ntuitive', text: 'Plain YAML and automatic layout. No coordinates, no canvas to drag.' },
  { word: 'ntegrated', text: 'It lives in your repo and your docs site, and is checked at build time.' },
  { word: 'mpressive', text: 'Brand icons, light and dark, and diagrams worth putting on a page.' },
]
---

<section class="lp-hero">
  <svg class="lp-wires" viewBox="0 0 760 640" preserveAspectRatio="xMaxYMin slice" aria-hidden="true" focusable="false">
    <path class="base" d="M760 96H606V236H452V122H336"></path>
    <path class="packet" d="M760 96H606V236H452V122H336"></path>
    <path class="base" d="M760 330H664V430H524V350H392"></path>
    <path class="packet spark" d="M760 330H664V430H524V350H392"></path>
    <path class="base" d="M700 640V500H560V600H430"></path>
    <path class="packet" d="M700 640V500H560V600H430"></path>
    <rect x="282" y="100" width="56" height="40" rx="9"></rect>
    <rect x="338" y="328" width="56" height="40" rx="9"></rect>
    <rect x="376" y="580" width="56" height="40" rx="9"></rect>
    <rect x="424" y="216" width="56" height="40" rx="9"></rect>
  </svg>

  <div class="lp-wrap">
    <p class="lp-eyebrow">Open source · MIT · Astro and Starlight</p>
    <h1>
      Architecture diagrams you can
      <span class="lp-play">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 1.8v12.4L14 8z" fill="currentColor"></path></svg>press play
      </span>
      on.
    </h1>
    <p class="lp-lede">
      Describe your system in YAML. idocs lays it out, documents every box, and replays a request
      travelling through it, one step at a time. Readers see how it works instead of guessing.
    </p>
    <p class="lp-iwords-label">the <b>i</b> in idocs</p>
    <ul class="lp-iwords">
      {
        iwords.map((w) => (
          <li>
            <b class="lp-iword">
              <span class="lp-i">i</span>
              {w.word}
            </b>
            <span>{w.text}</span>
          </li>
        ))
      }
    </ul>
    <div class="lp-cta">
      <a class="lp-btn lp-btn-primary" href={withBase('guides/getting-started/')}>
        Get started
        <Icon class="lp-arrow" name="lucide:arrow-right" />
      </a>
      <a class="lp-btn lp-btn-ghost" href={withBase('playground/')}>Open playground</a>
      <div class="lp-install">
        <span class="lp-prompt">$</span>
        <code>{install}</code>
        <button class="lp-copy" type="button" data-copy={install} aria-label="Copy command">
          <Icon name="lucide:copy" />
        </button>
      </div>
    </div>
  </div>

  <div class="lp-wrap lp-stage-wrap">
    <div class="lp-stage">
      <div class="lp-stage-bar">
        <span class="lp-live"><b>showcase</b></span>
        <span>{nodes} nodes · {scenarios} scenarios · {views} views</span>
        <span class="lp-hint">The real thing, not a screenshot. Click a box, expand a card, switch a view.</span>
      </div>
      <div class="lp-stage-body">
        <Diagram name="showcase" scenario="order" autoplay hash={false} maxHeight={560} />
      </div>
      <ul class="lp-try" aria-label="Things to try in the diagram above">
        <li><Icon name="lucide:mouse-pointer-click" /><span><b>Click a box</b> for its docs and a picture of what is inside</span></li>
        <li><Icon name="lucide:maximize-2" /><span><b>Expand</b> a card to see its diagram in place, or <b>open</b> it</span></li>
        <li><Icon name="lucide:play" /><span><b>Play</b> a scenario as packets, a sequence or a story</span></li>
        <li><Icon name="lucide:layers" /><span><b>Switch views</b>, hide what is planned, resize the viewer</span></li>
      </ul>
    </div>
  </div>
</section>
