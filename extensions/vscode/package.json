{
  "name": "idocs-vscode",
  "displayName": "idocs",
  "version": "0.3.0",
  "private": true,
  "description": "Syntax highlighting, validation, completion and a live preview for idocs architecture diagrams.",
  "license": "MIT",
  "publisher": "thepackagelabs",
  "preview": true,
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1920",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "idocs",
    "architecture",
    "diagram",
    "diagrams",
    "yaml",
    "documentation",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Package-Labs/idocs.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/The-Package-Labs/idocs/tree/main/extensions/vscode#readme",
  "bugs": {
    "url": "https://github.com/The-Package-Labs/idocs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:idocs",
    "workspaceContains:**/diagrams/*/diagram.yaml",
    "workspaceContains:**/diagrams/*/diagram.yml",
    "onWebviewPanel:idocs.preview"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "idocs reads the files of a diagram folder from disk."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "idocs",
        "aliases": [
          "idocs",
          "idocs diagram"
        ],
        "filenamePatterns": [
          "**/diagrams/*/diagram.yaml",
          "**/diagrams/*/diagram.yml",
          "**/diagrams/*/scenarios/*.yaml",
          "**/diagrams/*/scenarios/*.yml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon-light.svg",
          "dark": "./images/icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "idocs",
        "scopeName": "source.idocs",
        "path": "./syntaxes/idocs.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown"
        }
      },
      {
        "scopeName": "markdown.idocs.codeblock",
        "path": "./syntaxes/idocs-markdown.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.idocs": "idocs"
        }
      }
    ],
    "snippets": [
      {
        "language": "idocs",
        "path": "./snippets/idocs.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "idocs.openPreview",
        "title": "Open Preview",
        "category": "idocs",
        "icon": "$(open-preview)"
      },
      {
        "command": "idocs.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "idocs",
        "icon": "$(open-preview)"
      },
      {
        "command": "idocs.lockPreview",
        "title": "Keep Preview on This Diagram",
        "category": "idocs",
        "icon": "$(unlock)"
      },
      {
        "command": "idocs.unlockPreview",
        "title": "Let Preview Follow the Active Diagram",
        "category": "idocs",
        "icon": "$(lock)"
      },
      {
        "command": "idocs.refreshPreview",
        "title": "Refresh Preview",
        "category": "idocs",
        "icon": "$(refresh)"
      },
      {
        "command": "idocs.newDiagram",
        "title": "New Diagram",
        "category": "idocs",
        "icon": "$(new-file)"
      },
      {
        "command": "idocs.insertIcon",
        "title": "Insert Icon",
        "category": "idocs"
      },
      {
        "command": "idocs.checkAll",
        "title": "Check All Diagrams",
        "category": "idocs"
      },
      {
        "command": "idocs.showOutput",
        "title": "Show Output",
        "category": "idocs"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "idocs.openPreviewToSide",
          "when": "editorLangId == idocs && !idocs.previewOpen",
          "group": "navigation@1"
        },
        {
          "command": "idocs.lockPreview",
          "when": "activeWebviewPanelId == idocs.preview && !idocs.previewLocked",
          "group": "navigation@1"
        },
        {
          "command": "idocs.unlockPreview",
          "when": "activeWebviewPanelId == idocs.preview && idocs.previewLocked",
          "group": "navigation@1"
        },
        {
          "command": "idocs.refreshPreview",
          "when": "activeWebviewPanelId == idocs.preview",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "idocs.openPreviewToSide",
          "when": "resourceFilename =~ /^diagram\\.ya?ml$/",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "idocs.openPreviewToSide",
          "when": "editorLangId == idocs",
          "group": "idocs@1"
        },
        {
          "command": "idocs.insertIcon",
          "when": "editorLangId == idocs",
          "group": "idocs@2"
        }
      ],
      "commandPalette": [
        {
          "command": "idocs.lockPreview",
          "when": "idocs.previewOpen && !idocs.previewLocked"
        },
        {
          "command": "idocs.unlockPreview",
          "when": "idocs.previewOpen && idocs.previewLocked"
        },
        {
          "command": "idocs.refreshPreview",
          "when": "idocs.previewOpen"
        },
        {
          "command": "idocs.insertIcon",
          "when": "editorLangId == idocs"
        }
      ]
    },
    "keybindings": [
      {
        "command": "idocs.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == idocs"
      },
      {
        "command": "idocs.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == idocs && !terminalFocus"
      }
    ],
    "configuration": {
      "title": "idocs",
      "properties": {
        "idocs.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check diagrams as you type and show errors and warnings in the Problems panel. The same checks run with `idocs check`."
        },
        "idocs.updateDelay": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "markdownDescription": "Milliseconds to wait after typing before checking the diagram and updating the preview."
        },
        "idocs.preview.refreshOn": {
          "type": "string",
          "enum": [
            "type",
            "save"
          ],
          "default": "type",
          "enumDescriptions": [
            "Update the preview as you type, from unsaved text.",
            "Update the preview only when the file is saved."
          ],
          "markdownDescription": "When the preview shows your changes. Problems are always checked as you type."
        },
        "idocs.preview.followCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Outline the node in the preview that the editor cursor is in."
        }
      }
    },
    "configurationDefaults": {
      "[idocs]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.autoIndent": "advanced"
      }
    },
    "walkthroughs": [
      {
        "id": "idocs.start",
        "title": "Get started with idocs",
        "description": "Write an architecture diagram and watch it draw itself.",
        "steps": [
          {
            "id": "create",
            "title": "Start a diagram",
            "description": "Create a diagram folder with a small working example.\n[New Diagram](command:idocs.newDiagram)",
            "media": {
              "markdown": "walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:idocs.newDiagram"
            ]
          },
          {
            "id": "preview",
            "title": "See it as you type",
            "description": "Open the live preview beside the file.\n[Open Preview to the Side](command:idocs.openPreviewToSide)",
            "media": {
              "markdown": "walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:idocs.openPreviewToSide",
              "onCommand:idocs.openPreview"
            ]
          },
          {
            "id": "write",
            "title": "Write faster",
            "description": "Completion, hover, rename and go to definition work on node ids, kinds and icons.\n[Insert Icon](command:idocs.insertIcon)",
            "media": {
              "markdown": "walkthrough/write.md"
            },
            "completionEvents": [
              "onCommand:idocs.insertIcon"
            ]
          },
          {
            "id": "check",
            "title": "Check your work",
            "description": "Problems show as you type; check every diagram at once.\n[Check All Diagrams](command:idocs.checkAll)",
            "media": {
              "markdown": "walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:idocs.checkAll"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "grammar": "node scripts/grammar.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p webview/tsconfig.json && tsc -p e2e/tsconfig.json",
    "package": "node scripts/package.mjs",
    "test:integration": "node scripts/integration.mjs"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/simple-icons": "^1.2.99",
    "@the-package-labs/idocs-core": "workspace:^",
    "@the-package-labs/idocs-react": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.1"
  }
}
