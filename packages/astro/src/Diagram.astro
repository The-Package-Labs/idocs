---
import { nestedDiagrams } from '@the-package-labs/idocs-core'
import { DiagramView } from '@the-package-labs/idocs-react'
import '@the-package-labs/idocs-react/styles.css'
import { diagrams } from 'virtual:idocs/diagrams'

interface Props {
  /** Folder name under `diagrams/`. */
  name: string
  /** View id to show first. */
  view?: string
  /** Scenario id to select first. */
  scenario?: string
  mode?: 'flow' | 'sequence' | 'story'
  /** Tallest the canvas may grow, in px. */
  maxHeight?: number
  showTitle?: boolean
  /** Show the diagram's description above the views. */
  showDescription?: boolean
  /** Play `scenario` as soon as the diagram scrolls into view. */
  autoplay?: boolean
  /** Keep the scenario, step and opened nodes in the URL hash (default true). Turn off for decorative embeds. */
  hash?: boolean
}

const { name, ...props } = Astro.props
const diagram = diagrams[name]
if (!diagram) {
  const known = Object.keys(diagrams)
  throw new Error(
    `<Diagram name="${name}"> does not match a diagram. ${known.length ? `Available: ${known.join(', ')}.` : 'No diagrams were found in diagrams/.'}`,
  )
}

// Nodes with a `diagram:` key open another diagram in place, so the page carries every diagram
// this one can reach. Most pages have none and carry nothing extra.
const nested = nestedDiagrams(diagrams, name)
---

<div class="idocs-bleed not-content">
  <DiagramView client:visible diagram={diagram} diagrams={nested} {...props} />
</div>
