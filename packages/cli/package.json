{
  "name": "@the-package-labs/idocs",
  "version": "0.5.0",
  "type": "module",
  "bin": {
    "idocs": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@the-package-labs/idocs-core": "workspace:^"
  },
  "description": "The idocs command line: check, list, schema, icons search, new.",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Package-Labs/idocs.git"
  },
  "homepage": "https://github.com/The-Package-Labs/idocs#readme",
  "publishConfig": {
    "access": "public",
    "bin": {
      "idocs": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
