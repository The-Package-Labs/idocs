{
  "name": "@the-package-labs/idocs-core",
  "version": "0.4.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "elkjs": "^0.12.0",
    "mdast-util-to-hast": "^13.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "description": "Schema, compiler, layout, edge router and scenario timeline for idocs diagrams.",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Package-Labs/idocs.git"
  },
  "homepage": "https://github.com/The-Package-Labs/idocs#readme",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  },
  "license": "MIT"
}
