{
  "name": "@the-package-labs/idocs-react",
  "version": "0.5.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@the-package-labs/idocs-core": "workspace:^",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "description": "The interactive diagram component for idocs: pan and zoom, drawer, scenario player, sequence view.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Package-Labs/idocs.git"
  },
  "homepage": "https://github.com/The-Package-Labs/idocs#readme",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "license": "MIT"
}
