{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idocs diagram",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "description": "Markdown shown above the first view.",
      "type": "string"
    },
    "defaults": {
      "description": "How the diagram opens: its view, scenario and mode, and whether the panel and subtitles show. A page can still choose otherwise with the props of `<Diagram>`.",
      "type": "object",
      "properties": {
        "view": {
          "description": "View shown first. Defaults to the view of `scenario`, or else the first view.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "scenario": {
          "description": "Scenario selected first. Without it the diagram opens on its overview. It does not play until a reader presses play, unless `autoplay` is on.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "mode": {
          "description": "How a scenario is drawn when it has no `mode` of its own: packets over the diagram, a sequence diagram, or a swimlane story.",
          "type": "string",
          "enum": [
            "flow",
            "sequence",
            "story"
          ]
        },
        "sidebar": {
          "description": "Whether the panel over the picture starts open. By default it does when there is a scenario or another view to choose, and the frame is wide enough.",
          "type": "boolean"
        },
        "subtitles": {
          "description": "Words over the picture saying what the scenario is doing. On by default.",
          "type": "boolean"
        },
        "autoplay": {
          "description": "Play `scenario` as soon as the diagram is on screen. Needs `scenario`, and is ignored when the system asks for reduced motion.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string"
          },
          "family": {
            "type": "string",
            "enum": [
              "blue",
              "amber",
              "violet",
              "green",
              "teal",
              "red",
              "slate"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "edgeKinds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dash": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "caption": {
                "description": "Muted text after the label (network, runtime).",
                "type": "string"
              },
              "in": {
                "description": "Id of the parent group.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "rows": {
                "description": "Explicit rows of member ids, top to bottom. Each row is spread across the group width.",
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                }
              },
              "layout": {
                "description": "flow: auto layout (default). row/grid: pack members tightly (for stores and other edge-less cards).",
                "type": "string",
                "enum": [
                  "flow",
                  "row",
                  "grid"
                ]
              },
              "columns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "direction": {
                "description": "Flow direction inside a top-level group. AUTO (default) picks the squarer result.",
                "type": "string",
                "enum": [
                  "AUTO",
                  "RIGHT",
                  "DOWN"
                ]
              },
              "family": {
                "type": "string",
                "enum": [
                  "blue",
                  "amber",
                  "violet",
                  "green",
                  "teal",
                  "red",
                  "slate"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "built",
                  "planned",
                  "legacy",
                  "optional"
                ]
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "title": {
                "description": "Display name. Defaults to the node id.",
                "type": "string"
              },
              "sub": {
                "description": "One line under the title, rendered in mono (ports, stack, version).",
                "type": "string"
              },
              "pill": {
                "description": "Short label in the card header, like `TABLE` or `ES INDEX`.",
                "type": "string"
              },
              "lines": {
                "description": "Short body lines inside the card.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fields": {
                "description": "Makes the card an entity: a table of fields, each `name: type`. `ref` points a field at another entity.",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "description": "Its type: `keyword`, `uuid`, `string[]`.",
                                "type": "string"
                              },
                              "key": {
                                "description": "Part of the primary key. Shown with a `#` in front.",
                                "type": "boolean"
                              },
                              "ref": {
                                "description": "The `node` or `node.field` this one points at, like a foreign key. Draws a relation between the two cards.",
                                "type": "string"
                              },
                              "note": {
                                "description": "Shown on hover and in the drawer.",
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              "icon": {
                "description": "`postgresql`, `logos:redis`, `lucide:server` or ./path/to.svg.",
                "type": "string"
              },
              "kind": {
                "description": "Gives a default icon and colour family. See `kinds`.",
                "type": "string"
              },
              "family": {
                "description": "Accent colour family; overrides the kind default.",
                "type": "string",
                "enum": [
                  "blue",
                  "amber",
                  "violet",
                  "green",
                  "teal",
                  "red",
                  "slate"
                ]
              },
              "in": {
                "description": "Id of the group this node belongs to.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "built",
                  "planned",
                  "legacy",
                  "optional"
                ]
              },
              "badge": {
                "description": "Numbered marker on the card.",
                "type": [
                  "string",
                  "number"
                ]
              },
              "uses": {
                "description": "Small \"uses: a · b\" tag line.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "chips": {
                "description": "Small boxes inside the card, e.g. virtual hosts.",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "sub": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "w": {
                "description": "Card width in px (default 178).",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "description": {
                "description": "Markdown shown in the detail drawer.",
                "type": "string"
              },
              "doc": {
                "description": "Markdown file for the drawer. Defaults to nodes/<id>.md when present.",
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ],
                  "additionalProperties": false
                }
              },
              "refs": {
                "description": "Source files or URLs this node is based on.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "diagram": {
                "description": "Another diagram (its folder name) that shows the inside of this node. The card gets buttons to expand it in place, as a group, or to open it one level deeper, with a way back.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Folder name of the diagram, under diagrams/."
                      },
                      "view": {
                        "description": "View to open first. Defaults to the scenario view, then the first.",
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+$"
                      },
                      "scenario": {
                        "description": "Scenario to select when the diagram opens.",
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+$"
                      },
                      "mode": {
                        "description": "both (default): the reader can expand it in place or open it. expand: only in place. open: only move into it.",
                        "type": "string",
                        "enum": [
                          "both",
                          "expand",
                          "open"
                        ]
                      },
                      "expanded": {
                        "description": "Start expanded in place, so the whole inner diagram shows as a group.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "a -> b, or a <-> b"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "description": "http (default), channel, tunnel, queue, ws, data, or a custom edgeKind.",
                "type": "string"
              },
              "both": {
                "description": "Arrow at both ends.",
                "type": "boolean"
              },
              "hidden": {
                "description": "Not drawn until a scenario uses it. Lets scenarios cross relationships you would rather not clutter the diagram with.",
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "built",
                  "planned",
                  "legacy",
                  "optional"
                ]
              },
              "key": {
                "description": "Letter shown on the edge and in the interfaces table.",
                "type": "string"
              },
              "auth": {
                "type": "string"
              },
              "payload": {
                "description": "What travels over this edge.",
                "type": "string"
              },
              "transport": {
                "type": "string"
              },
              "note": {
                "description": "Markdown.",
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "maxProperties": 1,
            "patternProperties": {
              "^\\S+\\s*(<->|->)\\s*\\S+$": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "label"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+$"
                      },
                      "label": {
                        "type": "string"
                      },
                      "kind": {
                        "description": "http (default), channel, tunnel, queue, ws, data, or a custom edgeKind.",
                        "type": "string"
                      },
                      "both": {
                        "description": "Arrow at both ends.",
                        "type": "boolean"
                      },
                      "hidden": {
                        "description": "Not drawn until a scenario uses it. Lets scenarios cross relationships you would rather not clutter the diagram with.",
                        "type": "boolean"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "built",
                          "planned",
                          "legacy",
                          "optional"
                        ]
                      },
                      "key": {
                        "description": "Letter shown on the edge and in the interfaces table.",
                        "type": "string"
                      },
                      "auth": {
                        "type": "string"
                      },
                      "payload": {
                        "description": "What travels over this edge.",
                        "type": "string"
                      },
                      "transport": {
                        "type": "string"
                      },
                      "note": {
                        "description": "Markdown.",
                        "type": "string"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "views": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "description": "Markdown shown above the diagram.",
            "type": "string"
          },
          "include": {
            "description": "Node or group ids. Groups include their members.",
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                }
              }
            ]
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "direction": {
            "description": "Main flow direction. AUTO (default) tries RIGHT and DOWN and keeps the one that reads larger.",
            "type": "string",
            "enum": [
              "AUTO",
              "RIGHT",
              "DOWN",
              "LEFT",
              "UP"
            ]
          },
          "keys": {
            "description": "Assign letter keys (A, B, ...) to edges.",
            "type": "boolean"
          },
          "interfaces": {
            "description": "Show the interfaces table under the diagram.",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "mode": {
            "description": "How the scenario opens: packets over the diagram, a sequence diagram, or a swimlane story.",
            "type": "string",
            "enum": [
              "flow",
              "sequence",
              "story"
            ]
          },
          "lanes": {
            "description": "Columns of the story view, left to right. Nodes you leave out get a lane of their own at the end.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "sub": {
                  "description": "Under the title. Defaults to the node subtitle, or the node titles joined.",
                  "type": "string"
                },
                "nodes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "description": "Nodes shown in this lane."
                }
              },
              "required": [
                "title",
                "nodes"
              ],
              "additionalProperties": false
            }
          },
          "summary": {
            "description": "Markdown: the story in a few sentences.",
            "type": "string"
          },
          "view": {
            "description": "View to play on. Defaults to the first view.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "steps": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      }
                    ],
                    "description": "a -> b: label | at node: label | par: [steps] | { from, to, label, kind, note, status, via }"
                  }
                }
              },
              "required": [
                "title",
                "steps"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ],
              "description": "a -> b: label | at node: label | par: [steps] | { from, to, label, kind, note, status, via }"
            }
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "nodes"
  ],
  "additionalProperties": false
}
